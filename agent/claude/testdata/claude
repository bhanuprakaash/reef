#!/bin/sh
# Fake claude for the adapter tests; FAKE_CLAUDE picks the scenario.
case "$FAKE_CLAUDE" in
hang)
	echo '{"type":"system","subtype":"init","session_id":"s1"}'
	exec sleep 30
	;;
big)
	printf '{"type":"noise","pad":"'
	head -c 17000000 /dev/zero | tr '\0' a
	printf '"}\n'
	echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"done"}]}}'
	echo '{"type":"result","is_error":false,"usage":{"input_tokens":1,"output_tokens":2,"cache_creation_input_tokens":3,"cache_read_input_tokens":4}}'
	;;
badresume)
	echo '{"type":"result","is_error":true,"errors":["No conversation found"]}'
	echo boom >&2
	exit 1
	;;
resumebg)
	echo '{"type":"system","subtype":"task_notification","task_id":"b2wltrd12","status":"stopped","summary":"Background shell command didn'"'"'t finish before the previous session ended","session_id":"d6c291c5-ec96-403e-9f97-720d1dee78db"}'
	echo '{"type":"system","subtype":"init","session_id":"d6c291c5-ec96-403e-9f97-720d1dee78db"}'
	echo '{"type":"result","subtype":"success","is_error":false,"num_turns":0,"result":"","origin":{"kind":"task-notification"},"session_id":"d6c291c5-ec96-403e-9f97-720d1dee78db","usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0}}'
	read -r prompt
	echo '{"type":"system","subtype":"init","session_id":"d6c291c5-ec96-403e-9f97-720d1dee78db"}'
	echo '{"type":"user","message":{"role":"user","content":"What is 7 times 6?"},"parent_tool_use_id":null,"isReplay":true}'
	echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"42"}},"parent_tool_use_id":null}'
	echo '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"42"}],"usage":{"input_tokens":2,"cache_creation_input_tokens":425,"cache_read_input_tokens":18362,"output_tokens":3}},"parent_tool_use_id":null}'
	echo '{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"input_tokens":2,"cache_creation_input_tokens":425,"cache_read_input_tokens":18362,"output_tokens":3}},"parent_tool_use_id":null}'
	echo '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"result":"42","session_id":"d6c291c5-ec96-403e-9f97-720d1dee78db","usage":{"input_tokens":2,"cache_creation_input_tokens":425,"cache_read_input_tokens":18362,"output_tokens":3}}'
	;;
argv)
	echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"'"$*"'"}]}}'
	;;
esac
