#!/bin/sh
# Fake `codex app-server`. FAKE_CODEX: hang (default), slowstart, deafstart, rejected, midcrash, failstart, crash, replay, twocalls, twomsgs, usagehang, stopusage, stopmerge.
[ "$FAKE_CODEX" = slowstart ] && exec sleep 30
[ "$FAKE_CODEX" = deafstart ] && { trap '' TERM; exec sleep 30; }
read -r line
echo '{"id":1,"result":{"userAgent":"fake"}}'
read -r line
read -r line
if [ "$FAKE_CODEX" = failstart ]; then
	echo '{"id":2,"error":{"code":-32600,"message":"bad sandbox"}}'
	exec sleep 30
fi
echo '{"id":2,"result":{"thread":{"id":"t1"}}}'
if [ "$FAKE_CODEX" = replay ]; then
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":100,"cachedInputTokens":0,"outputTokens":1}}}}'
fi
read -r line
if [ "$FAKE_CODEX" = rejected ]; then
	echo '{"id":3,"error":{"code":-32600,"message":"bad turn"}}'
	exec sleep 30
fi
echo '{"id":3,"result":{}}'
echo '{"method":"turn/started","params":{"turn":{"status":"inProgress"}}}'
echo '{"method":"item/agentMessage/delta","params":{"itemId":"m1","delta":"hi"}}'
case "$FAKE_CODEX" in
replay)
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":4,"cacheWriteInputTokens":2,"outputTokens":3}}}}'
	echo '{"method":"turn/completed","params":{"turn":{"status":"completed"}}}'
	exec sleep 30
	;;
twocalls)
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":4,"cacheWriteInputTokens":2,"outputTokens":3}}}}'
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":7,"cachedInputTokens":1,"outputTokens":5}}}}'
	echo '{"method":"turn/completed","params":{"turn":{"status":"completed"}}}'
	exec sleep 30
	;;
twomsgs)
	echo '{"method":"item/agentMessage/delta","params":{"itemId":"m1","delta":"a1"}}'
	echo '{"method":"item/agentMessage/delta","params":{"itemId":"m1","delta":"a2"}}'
	echo '{"method":"item/started","params":{"item":{"type":"commandExecution","id":"c1","command":"ls"}}}'
	echo '{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"c1","status":"completed","aggregatedOutput":"x","exitCode":0}}}'
	echo '{"method":"item/agentMessage/delta","params":{"itemId":"m2","delta":"b1"}}'
	echo '{"method":"turn/completed","params":{"turn":{"status":"completed"}}}'
	exec sleep 30
	;;
usagehang)
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":4,"outputTokens":3}}}}'
	exec sleep 30
	;;
stopmerge|stopusage)
	echo '{"method":"item/started","params":{"item":{"type":"commandExecution","id":"c1","command":"sleep 60"}}}'
	[ "$FAKE_CODEX" = stopmerge ] && echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":4,"outputTokens":3}}}}'
	read -r line
	echo '{"id":"stop","result":{}}'
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":7,"cachedInputTokens":1,"outputTokens":5}}}}'
	echo '{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"c1","status":"failed","aggregatedOutput":"","exitCode":null}}}'
	echo '{"method":"turn/completed","params":{"turn":{"status":"interrupted"}}}'
	exec sleep 30
	;;
midcrash)
	echo '{"method":"thread/tokenUsage/updated","params":{"tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":4,"outputTokens":3}}}}'
	echo boom >&2
	exit 3
	;;
crash)
	echo '{"method":"turn/completed","params":{"turn":{"status":"completed"}}}'
	echo boom >&2
	exit 3
	;;
*)
	exec sleep 30
	;;
esac
